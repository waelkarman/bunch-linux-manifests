# llama-server configuration (llama-server.service, read also by llm-chat).
# Every LLAMA_ARG_* variable is a llama-server option (llama-server --help).
# Apply changes with: systemctl restart llama-server

# GGUF model: default.gguf is a symlink installed by the model package
LLAMA_ARG_MODEL=/usr/share/llama/models/default.gguf
LLAMA_ARG_ALIAS=bunch-llm

# OpenAI-compatible API (/v1/chat/completions) on localhost only.
# Use 0.0.0.0 to reach it from the network: there is no authentication
# unless LLAMA_API_KEY is set.
LLAMA_ARG_HOST=127.0.0.1
LLAMA_ARG_PORT=8080

# Pi 4: 4 x Cortex-A72. 3 threads leave a core to the UI and object-detector.
LLAMA_ARG_THREADS=3
# Context in tokens (prompt + answer); one conversation at a time
LLAMA_ARG_CTX_SIZE=4096
LLAMA_ARG_N_PARALLEL=1

# No embedded Web UI (not built): the GUI is llm-chat
LLAMA_ARG_UI=false
