# Bunch Linux A/B boot script for RAUC (U-Boot backend).
#
# The kernel is loaded from /boot of the selected rootfs slot, so kernel and
# modules are always updated together by a RAUC bundle. The device tree and
# overlays come from the firmware (boot partition) via ${fdt_addr}.

fdt addr ${fdt_addr} && fdt get value default_bootargs /chosen bootargs

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv rauc_part
setenv rauc_args
for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test "x${rauc_args}" != "x"; then
    # skip remaining slots
  elif test "x${BOOT_SLOT}" = "xA"; then
    if test 0x${BOOT_A_LEFT} -gt 0; then
      echo "Found valid slot A, ${BOOT_A_LEFT} attempts remaining"
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      setenv rauc_part 2
      setenv rauc_args "root=/dev/mmcblk0p2 rauc.slot=A"
    fi
  elif test "x${BOOT_SLOT}" = "xB"; then
    if test 0x${BOOT_B_LEFT} -gt 0; then
      echo "Found valid slot B, ${BOOT_B_LEFT} attempts remaining"
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      setenv rauc_part 3
      setenv rauc_args "root=/dev/mmcblk0p3 rauc.slot=B"
    fi
  fi
done

if test -n "${rauc_args}"; then
  saveenv
else
  echo "No valid slot found, resetting tries to 3"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

# root= given last wins over the one coming from cmdline.txt.
setenv bootargs "${default_bootargs} ${rauc_args} rootfstype=ext4 rootwait"
load @@BOOT_MEDIA@@ 0:${rauc_part} ${kernel_addr_r} /boot/@@KERNEL_IMAGETYPE@@
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}
